{
  "name": "caquick-be",
  "version": "0.0.1",
  "description": "케이퀵(CaQuick) 백엔드 - 시각 기반 올인원 맞춤 케이크 주문 플랫폼",
  "author": "chanwoo7",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "graphql:codegen": "graphql-codegen --config codegen.yml",
    "graphql:docs": "spectaql -c spectaql.yml",
    "dto:check": "ts-node -r tsconfig-paths/register scripts/check-graphql-dto-sync.ts",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "knip": "knip --no-config-hints",
    "validate": "yarn lint && npx tsc --noEmit && yarn dto:check && yarn arch:check && yarn test:cov",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "logform": "^2.7.0",
    "openid-client": "5.7.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "useragent": "^2.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^21.2.2",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "11.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30",
    "@types/node": "^25.8.0",
    "@types/passport": "^1",
    "@types/passport-jwt": "^4",
    "@types/supertest": "^7.2.1",
    "@types/useragent": "^2",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "mysql2": "^3.24.2",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "spectaql": "^3.0.9",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": false
          },
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/index.ts",
      "!**/main.ts",
      "!**/*.module.ts",
      "!**/*.d.ts",
      "!**/graphql/graphql.types.ts",
      "!**/config/**",
      "!test/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 96,
        "branches": 86,
        "functions": 92,
        "lines": 96
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/jest.global-setup.ts",
    "globalTeardown": "<rootDir>/test/jest.global-teardown.ts",
    "testTimeout": 60000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.4"
}
