# 앱 컨테이너(api·worker·migrate)의 app.env — 앱이 읽는 값만. 키 목록만, 값은 GitHub Environment `production` secret APP_ENV에서
# 배포 잡(07)이 쓴다. 검증 스키마는 src/config/*.ts, 설명은 README "필요 환경 변수".
# DATABASE_URL·RABBITMQ_URL의 비밀번호는 .env의 MYSQL_PASSWORD·RABBITMQ_PASSWORD와 같아야 한다.

# ---- 앱: 서버 ----
NODE_ENV=production
BACKEND_BASE_URL=https://api.caquick.site
FRONTEND_BASE_URL=https://www.caquick.site
TRUST_PROXY_HOPS=1

# ---- 앱: 연결(컨테이너 이름) ----
DATABASE_URL=mysql://caquick:<MYSQL_PASSWORD>@mysql:3306/CaQuick
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://<RABBITMQ_USER>:<RABBITMQ_PASSWORD>@rabbitmq:5672

# ---- 앱: 인증 ----
JWT_PRIVATE_KEY_PEM_B64=   # 운영 필수(NODE_ENV=production이면 미설정 시 부팅 실패)
JWT_PUBLIC_KEY_PEM_B64=
JWT_ISSUER=caquick-identity
JWT_AUDIENCE=caquick-api
JWT_ACCESS_EXPIRES_SECONDS=900
AUTH_REFRESH_EXPIRES_DAYS=14
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GOOGLE_ISSUER_URL=https://accounts.google.com
OIDC_KAKAO_CLIENT_ID=
OIDC_KAKAO_CLIENT_SECRET=
OIDC_KAKAO_ISSUER_URL=https://kauth.kakao.com
OIDC_TEMP_COOKIE_MAX_AGE_MS=

# ---- 앱: S3(미디어) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=   # 운영 필수(NODE_ENV=production이면 미설정 시 부팅 실패)
S3_PRESIGN_EXPIRES_SECONDS=

# ---- 앱: 운영 ----
METRICS_ACCESS_TOKEN=   # 운영 필수(NODE_ENV=production이면 미설정 시 부팅 실패)
DOCS_ACCESS_TOKEN=   # 운영 필수(NODE_ENV=production이면 미설정 시 부팅 실패)
DISCORD_ALERT_WEBHOOK_URL=
ALERT_DEDUPE_WINDOW_MS=
OUTBOX_MAX_ATTEMPTS=
OUTBOX_PARTITION_CONCURRENCY=
