# 운영 compose(infra/compose.yml)의 .env — compose 보간 + 저장소·터널·Grafana 비밀. 키 목록만, 값은 GitHub Environment
# `production` secret DOTENV에서 배포 잡(07)이 쓴다. 앱이 읽는 값은 app.env(app.env.example) — 컨테이너에 이 파일을 주입하지 않는다.

# ---- compose ----
IMAGE=ghcr.io/caquick/caquick-be
IMAGE_TAG=main
API_HOST_PORT=4000
RABBITMQ_MGMT_HOST_PORT=15672
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# ---- 저장소 컨테이너 ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=CaQuick
MYSQL_USER=caquick
MYSQL_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
TUNNEL_TOKEN=
# Prometheus가 앱 /metrics를 긁을 때 쓰는 Bearer 토큰 — app.env의 METRICS_ACCESS_TOKEN과 같은 값(배포 잡이 app.env에서 복사)
METRICS_ACCESS_TOKEN=

# ---- 백업(08) ----
# UTC 시(0~23, 한 자리도 됨)
BACKUP_HOUR=19
BACKUP_S3_BUCKET=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=ap-northeast-2
