# 운영 compose(infra/compose.yml)의 .env — compose 보간 + 저장소·터널·Grafana 비밀. 키 목록만, 값은 GitHub Environment
# `production` secret DOTENV에서 배포 잡(07)이 쓴다. 앱이 읽는 값은 app.env(app.env.example) — 컨테이너에 이 파일을 주입하지 않는다.

# ---- compose ----
IMAGE=ghcr.io/caquick/caquick-be
# 배포 잡이 커밋 sha로 덮어쓴다(GHCR에는 sha 태그만). 로컬 빌드는 IMAGE=caquick-be IMAGE_TAG=local
IMAGE_TAG=
API_HOST_PORT=4000
RABBITMQ_MGMT_HOST_PORT=15672
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001

# ---- 저장소 컨테이너 ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=CaQuick
MYSQL_USER=caquick
MYSQL_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Grafana secure 설정(웹훅 등) 암호화 키 — 임의 문자열 32자 이상. 바꾸면 저장된 secure 설정을 다시 프로비저닝해야 한다
GRAFANA_SECRET_KEY=
# mysqld_exporter 전용 MySQL 사용자 비밀번호(첫 초기화 때 생성, 이미 있는 볼륨은 runbook)
MYSQL_EXPORTER_PASSWORD=
TUNNEL_TOKEN=
# Prometheus가 앱 /metrics를 긁을 때 쓰는 Bearer 토큰 — app.env의 METRICS_ACCESS_TOKEN과 같은 값(배포 잡이 app.env에서 복사)
METRICS_ACCESS_TOKEN=

# ---- 백업(08) ----
# UTC 시(0~23, 한 자리도 됨)
BACKUP_HOUR=19
BACKUP_S3_BUCKET=caquick-db-backup
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=ap-northeast-2
# 백업 실패 경보 — app.env의 웹훅과 같은 값(배포 잡이 app.env에서 복사)
DISCORD_ALERT_WEBHOOK_URL=
